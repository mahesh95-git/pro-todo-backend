# PostgreSQL connection string for Prisma
# Replace with your actual PostgreSQL URL
DATABASE_URL="postgresql://user:password@localhost:5432/todolist?schema=public"

# Server Configuration
PORT=5000
NODE_ENV="development"

# JWT Configuration (generate a strong secret for production)
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRY="7d"

# For local development with Prisma Postgres, you can use:
# DATABASE_URL="prisma+postgres://localhost:5432/todolist"

